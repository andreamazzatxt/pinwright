{
  "name": "pinwright",
  "version": "0.3.3",
  "description": "Give Claude feedback right on your dev site: click an element, write a note, an agent edits your source.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreamazzatxt/pinwright.git"
  },
  "homepage": "https://github.com/andreamazzatxt/pinwright#readme",
  "bugs": "https://github.com/andreamazzatxt/pinwright/issues",
  "author": "Andrea Mazza",
  "bin": {
    "pinwright": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./astro": "./dist/astro.js",
    "./nuxt": "./dist/nuxt.js",
    "./next": "./dist/next.js",
    "./next/script": "./dist/next-script.js",
    "./webpack": "./dist/webpack.js",
    "./rspack": "./dist/webpack.js"
  },
  "files": [
    "dist",
    "overlay"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "tsc && node --test 'test/*.test.mjs'",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "claude",
    "agent",
    "feedback",
    "overlay",
    "vite",
    "astro",
    "nuxt",
    "nextjs",
    "sveltekit",
    "webpack",
    "rspack",
    "dev-tools"
  ],
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
